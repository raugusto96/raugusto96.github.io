generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model SnakeScore {
  id String @id @default(uuid()) @db.Uuid
  runId String @unique @db.Uuid
  nickname String @db.VarChar(24)
  score Int
  createdAt DateTime @default(now())
  @@index([score(sort: Desc), createdAt])
}
